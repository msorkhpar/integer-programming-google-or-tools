{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSnapshots",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["${bucket_arn}/snapshots/*"]
    },
    {
      "Sid": "WriteResults",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["${bucket_arn}/results/*"]
    }
  ]
}
