{
  "test_jobs_may_run_back_to_back": [
    ["model.new_fixed_size_interval_var(start[j.name], j.duration, f\"work_{j.name}\")", "model.new_fixed_size_interval_var(start[j.name], j.duration + 1, f\"work_{j.name}\")"]
  ],
  "test_a_job_may_end_exactly_at_its_deadline": [
    ["        model.add(start[j.name] + j.duration <= j.deadline)", "        model.add(start[j.name] + j.duration < j.deadline)"]
  ],
  "test_the_deadline_is_on_the_end_not_the_start": [
    ["        model.add(start[j.name] + j.duration <= j.deadline)", "        model.add(start[j.name] <= j.deadline)"]
  ],
  "test_the_last_week_of_a_blocked_period_is_blocked_too": [
    ["model.new_fixed_size_interval_var(first, last - first + 1, f\"blocked_{first}_{last}\")", "model.new_fixed_size_interval_var(first, last - first, f\"blocked_{first}_{last}\")"]
  ]
}
