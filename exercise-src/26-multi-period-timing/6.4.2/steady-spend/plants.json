{
  "test_a_drop_beyond_the_step_is_refused": [
    [
      "        model.add_linear_constraint(spend[before] - spend[after] <= max_step, name=f\"fall_{after}\")\n",
      ""
    ]
  ],
  "test_each_year_is_compared_with_the_year_before": [
    [
      "spend[after] - spend[before] <= max_step",
      "spend[after] - spend[years[0]] <= max_step"
    ],
    [
      "spend[before] - spend[after] <= max_step",
      "spend[years[0]] - spend[after] <= max_step"
    ]
  ],
  "test_the_last_pair_of_years_is_checked": [
    [
      "zip(years, years[1:])",
      "zip(years, years[1:-1])"
    ]
  ],
  "test_a_change_of_exactly_the_step_is_allowed": [
    [
      "spend[after] - spend[before] <= max_step,",
      "spend[after] - spend[before] <= max_step - 1,"
    ],
    [
      "spend[before] - spend[after] <= max_step,",
      "spend[before] - spend[after] <= max_step - 1,"
    ]
  ]
}
