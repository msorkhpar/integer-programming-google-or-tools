{
  "test_a_count_equal_to_its_cap_fits": [
    ["(max_vars is None or n_vars <= max_vars)", "(max_vars is None or n_vars < max_vars)"],
    ["(max_rows is None or n_rows <= max_rows)", "(max_rows is None or n_rows < max_rows)"]
  ],
  "test_a_sum_cap_counts_variables_and_rows_together": [
    ["            and (max_sum is None or n_vars + n_rows <= max_sum))", "            and (max_sum is None or max(n_vars, n_rows) <= max_sum))"]
  ],
  "test_a_quadratic_model_meets_the_quadratic_caps": [
    ["tier[\"quadratic\" if quadratic else \"linear\"]", "tier[\"linear\"]"]
  ],
  "test_a_missing_cap_is_no_cap": [
    ["(max_vars is None or n_vars <= max_vars)", "(n_vars <= (max_vars or 0))"],
    ["(max_rows is None or n_rows <= max_rows)", "(n_rows <= (max_rows or 0))"]
  ]
}
